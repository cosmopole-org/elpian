# Binary artifacts produced by .github/workflows/build_godot_artifacts.yml.
# They are large (the Godot AAR alone is ~21 MB), are reproducible from pinned
# upstream versions, and would otherwise be committed by a local build.
android/libs/*.aar
android/src/main/assets/godot/
godot-project/bin/

# Native extension build state and the reproducible godot-cpp checkout.
# No trailing slash on godot-cpp: a local checkout is usually a directory, but
# it is often a symlink into a shared cache, and `foo/` would not match that —
# which is how a symlink to an absolute developer path once got committed and
# broke `git clone` in CI with "could not create work tree dir: File exists".
extension/godot-cpp
extension/gen/
extension/.sconsign.dblite
# scons names shared-library objects .os, not .o.
extension/**/*.o
extension/**/*.os

# Godot editor state
godot-project/.godot/
