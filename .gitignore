# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Generated benchmark run output (written by performance_benchmark_test.dart /
# elpian_windows_benchmark_test.dart on every run). The committed baseline lives
# under bench/reports/presentmon/.
#
# NB: these paths were previously written as /benchmarks/..., which matched
# nothing — the directory is bench/ — so the generated files were tracked and
# rewritten on every benchmark run.
/bench/reports/elpian_results.json
/bench/reports/elpian_windows_results.json

# Rust build output. The workspace target/ dirs are large and fully derived.
target/
**/target/

# SCons intermediates from the Godot GDExtension build.
*.o
*.os
.sconsign.dblite

# The old example APK was committed by the removed build_android_apk.yml.
elpian_example.apk
